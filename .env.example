# ZeptoMail (transactional email for the contact form)
# Send Mail token from the ZeptoMail agent (without the "Zoho-enczapikey " prefix)
ZEPTOMAIL_TOKEN=
# Verified sender address on the agent's domain
ZEPTOMAIL_FROM_ADDRESS=no-reply@mahlangu.dev
# Template alias configured in the ZeptoMail dashboard
ZEPTOMAIL_TEMPLATE_ALIAS=portfolio-contact
# Inbox that receives contact form submissions
CONTACT_TO_ADDRESS=

# Umami (self-hosted page-view analytics)
# Website id for mahlangu.dev from the Umami dashboard. Not a secret (it ships in
# the public HTML), but it is set in Coolify as a build-time var, not committed.
# Leave unset locally: the analytics script is then not rendered at all.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional override for the tracker script URL.
# Defaults to https://analytics.lab.mahlangu.dev/script.js
NEXT_PUBLIC_UMAMI_SRC=
